# Copie para .env e ajuste. No Railway, cadastre estas variáveis no serviço.

# Porta do servidor (o Railway injeta PORT automaticamente)
PORT=3000

# Pasta com o banco (galera.db) e as fotos (uploads/). No Railway: /data (volume)
DATA_DIR=./data

# Frase longa e aleatória para assinar os cookies de sessão
SESSION_SECRET=troque-por-uma-frase-longa-e-aleatoria-com-mais-de-32-caracteres

# Código do convite que os convidados digitam na entrada. Vazio = sem código (decisão dos noivos:
# o link só circula no grupo da família). Para exigir, basta definir uma palavra aqui.
INVITE_CODE=

# Telefones (só dígitos, com 55) que têm acesso ao /admin, separados por vírgula
ADMIN_PHONES=5549999442022

# Código para abrir o telão da festa em /telao
TELAO_CODE=telao2026

# Tamanho máximo de cada foto enviada (MB)
MAX_UPLOAD_MB=12

# Endereço público do site (usado no QR code do telão e nos links)
PUBLIC_URL=http://localhost:5173

# Web Push (avisos de novas mensagens). Gere uma vez com:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# Sem as duas chaves, os avisos ficam desligados (o resto do site funciona normalmente).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contato do remetente: URL https do site ou mailto:
VAPID_SUBJECT=https://app.annacarolinaefernando.com

# Opcional: provedor de tiles do mapa. Padrão = OpenStreetMap (sem chave).
# Exemplos com chave gratuita: MapTiler, Stadia Maps, Thunderforest.
# MAP_TILE_URL=https://tiles.stadiamaps.com/tiles/alidade_smooth/{z}/{x}/{y}{r}.png?api_key=SUA_CHAVE
# MAP_TILE_ATTRIBUTION=&copy; Stadia Maps &copy; OpenMapTiles &copy; OpenStreetMap
